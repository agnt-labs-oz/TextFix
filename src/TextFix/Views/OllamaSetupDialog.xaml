<Window x:Class="TextFix.Views.OllamaSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up Ollama"
        Width="460" Height="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        Foreground="#E0E0E0"
        FontFamily="Segoe UI"
        Closing="OnClosing">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Set up Ollama" FontSize="16" FontWeight="SemiBold"
                   Foreground="#E0E0E0" Margin="0,0,0,6"/>
        <TextBlock Grid.Row="1" x:Name="SubtitleText" FontSize="12" Foreground="#AAAAAA"
                   TextWrapping="Wrap" Margin="0,0,0,14"
                   Text="Free local corrections — your text never leaves this machine."/>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="StatusText" FontSize="13" TextWrapping="Wrap"
                       Foreground="#E0E0E0" Margin="0,0,0,6" Text="Checking for Ollama…"/>
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100"
                         Background="#2D2D3F" Foreground="#6C63FF" BorderBrush="#555"
                         Visibility="Collapsed" Margin="0,0,0,4"/>
            <TextBlock x:Name="DetailText" FontSize="11" Foreground="#888888"
                       TextWrapping="Wrap" Text=""/>
        </StackPanel>

        <StackPanel Grid.Row="3" x:Name="ModelPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <TextBlock Text="Model to download" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
            <RadioButton x:Name="SmallModelRadio" IsChecked="True" Foreground="#E0E0E0" Margin="0,2,0,2"
                         Content="llama3.2:3b — 2 GB. Works on any machine; the occasional rough edit."/>
            <RadioButton x:Name="LargeModelRadio" Foreground="#E0E0E0" Margin="0,2,0,2"
                         Content="qwen2.5:7b — 4.7 GB. Better quality; wants a GPU."/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="ActionButton" Content="Continue" Width="130" Height="28"
                    Background="#6C63FF" Foreground="White" BorderBrush="Transparent"
                    FontSize="13" Cursor="Hand" Click="OnAction" Margin="0,0,8,0"/>
            <Button x:Name="CloseButton" Content="Cancel" Width="72" Height="28"
                    Background="#444" Foreground="#CCC" BorderBrush="Transparent"
                    FontSize="13" Cursor="Hand" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
